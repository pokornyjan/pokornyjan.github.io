---
interface Props {
  title: string;
  description: string;
  href?: string;
  category?: string;
}

const { title, description, href, category } = Astro.props;
---

{href ? (
  <a class="project project-link" href={href}>
    {category && <span class="project-card-category">{category}</span>}
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="project-arrow" aria-hidden="true">Read project →</span>
  </a>
) : (
  <article class="project">
    {category && <span class="project-card-category">{category}</span>}
    <h3>{title}</h3>
    <p>{description}</p>
  </article>
)}
