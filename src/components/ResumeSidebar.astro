---
interface ContactItem {
  type: "location" | "email" | "phone" | "website";
  value: string;
  detail?: string;
}

interface Skill {
  name: string;
  level: number;
}

interface Language {
  name: string;
  level: string;
}

interface Props {
  contact: ContactItem[];
  skills: Skill[];
  languages: Language[];
}

const { contact, skills, languages }: Props = Astro.props;
---

<aside class="sidebar">
  <h2>Contact</h2>
  <ul class="contact">
    {contact.map(({ type, value, detail }) => (
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          {type === "location" && <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z" />}
          {type === "email" && <path d="M20 4H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h16a2 2 0 0 0 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z" />}
          {type === "phone" && <path d="M6.6 10.8c1.4 2.8 3.7 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.1 21 3 13.9 3 5c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1l-2.2-.1z" />}
          {type === "website" && <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm7.9 9h-3.9a15.7 15.7 0 0 0-1.1-5.1A8 8 0 0 1 19.9 11zM12 4c1 1.4 1.7 3.8 2 7H10c.3-3.2 1-5.6 2-7zM4.1 13h3.9c.1 2 .5 3.8 1.1 5.1A8 8 0 0 1 4.1 13zm3.9-2H4.1A8 8 0 0 1 9.1 5.9 15.7 15.7 0 0 0 8 11zm4 9c-1-1.4-1.7-3.8-2-7h4c-.3 3.2-1 5.6-2 7zm2.9-6.9A15.7 15.7 0 0 0 16 13h3.9a8 8 0 0 1-5 5.1c.6-1.3 1-3.1 1.1-5.1z" />}
        </svg>
        <span>{value}{detail && <><br />{detail}</>}</span>
      </li>
    ))}
  </ul>

  <h2>Expertise</h2>
  {skills.map(({ name, level }) => (
    <div class="skill">
      <div class="skill-line"><span>{name}</span></div>
      <div class="dots" role="img" aria-label={`${name}: ${level} out of 5`}>
        {Array.from({ length: 5 }, (_, dotIndex) => <i class:list={['dot', { on: dotIndex < level }]} />)}
      </div>
    </div>
  ))}

  <h2>Languages</h2>
  {languages.map(({ name, level }) => (
    <div class="language"><span>{name}</span><span class="language-level">{level}</span></div>
  ))}
</aside>
