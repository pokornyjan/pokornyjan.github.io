---
import ProjectCard from "../components/ProjectCard.astro";
import ResumeHeader from "../components/ResumeHeader.astro";
import ResumeSection from "../components/ResumeSection.astro";
import ResumeSidebar from "../components/ResumeSidebar.astro";
import ResumeLayout from "../layouts/ResumeLayout.astro";

const contact: Array<{ type: "location" | "email" | "phone" | "website"; value: string; detail?: string }> = [
  { type: "email", value: "palacky.jan@outlook.com" },
  { type: "phone", value: "TBD" },
  { type: "website", value: "TBD" },
];
const skills = [
  { name: "Python", level: 4 },
  { name: "Linux", level: 3 },
  { name: "Docker", level: 3 },
  { name: "Git", level: 4 },
  { name: "CI/CD", level: 4 },
];
const languages = [
  { name: "Czech", level: "Native" },
  { name: "English", level: "Professional" },
  { name: "German", level: "Conversational" },
];
const summary = "";
const projects = [
  { title: "TBD", description: "TBD" },
  { title: "TBD", description: "TBD" },
];
---

<ResumeLayout title="Jan Palacký — Resume" description="Jan Palacký — Resume">
  <main class="resume">
    <ResumeSidebar contact={contact} skills={skills} languages={languages} />

    <div class="main">
      <ResumeHeader name="Jan Palacký" role="Software Engineer" summary={summary} />

      <ResumeSection title="Career Details">
        <nav class="career-links" aria-label="Career details">
          <a class="career-link" href="/experience/">
            <span class="career-link-title">Experience</span>
            <span class="career-link-description">View work history and sample responsibilities</span>
            <span class="career-link-arrow" aria-hidden="true">→</span>
          </a>
          <a class="career-link" href="/education/">
            <span class="career-link-title">Education</span>
            <span class="career-link-description">View sample education and training</span>
            <span class="career-link-arrow" aria-hidden="true">→</span>
          </a>
        </nav>
      </ResumeSection>

      <ResumeSection title="Selected Projects">
        <div class="projects">
          {projects.map((project) => <ProjectCard {...project} />)}
        </div>
      </ResumeSection>
    </div>
  </main>
</ResumeLayout>
