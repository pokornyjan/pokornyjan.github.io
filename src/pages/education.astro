---
import ResumeEntry from "../components/ResumeEntry.astro";
import ResumeSection from "../components/ResumeSection.astro";
import ResumeLayout from "../layouts/ResumeLayout.astro";
import { education } from "../data/education";
---

<ResumeLayout title="Education — Jan Palacký" description="Sample education for Jan Palacký's resume">
  <main class="detail-page">
    <a class="back-link" href="/">← Back to resume</a>
    <header class="detail-header">
      <h1 class="name">Education</h1>
      <p class="title">Education &amp; Training</p>
    </header>

    <p class="sample-notice"><strong>Sample text:</strong> The qualifications, institutions, dates, and descriptions below are examples only. Replace them with your actual education and training before publishing.</p>

    <ResumeSection title="Education &amp; Training">
      {education.map((entry) => <ResumeEntry {...entry} />)}
    </ResumeSection>

    <nav class="detail-nav" aria-label="Other resume pages">
      <a href="/experience/">View Experience →</a>
    </nav>
  </main>
</ResumeLayout>